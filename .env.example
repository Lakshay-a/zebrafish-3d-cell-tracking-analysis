# Repository-relative defaults work for outputs. Override external inputs here.
BATCH_PROJECT_DIR=/path/to/output_directory
BATCH_CZI_PATH=/path/to/input.czi
BATCH_CELL_TYPE=macrophage
TRACKING_METHOD=lap

# Trained Cellpose weights are external artefacts and are not committed.
MUSC_CELLPOSE_MODEL=/path/to/musc_cellpose_model
MACROPHAGE_CELLPOSE_MODEL=/path/to/macrophage_cellpose_model

# Optional batch roots.
CELL_TRACKING_DATA_ROOT=/path/to/czi_data_root
BATCH_OUTPUT_ROOT=/path/to/batch_output_root
OVERNIGHT_DIR=/path/to/overnight_batch_outputs
CZI_SEARCH_ROOT=/path/to/czi_data_root

# Optional injury-analysis overrides.
INJURY_BLOCKS_ROOT=/path/to/overnight_batch_outputs/MMP
INJURY_ANNOTATION_ROOT=/path/to/manual_injury_annotations_mmp
INJURY_FEATURE_OUTPUT_ROOT=/path/to/manual_injury_feature_outputs

# Dataset preparation and Cellpose model training
CELLPOSE_PROJECT_ROOT=/path/to/project
CELLPOSE_SOURCE_PATHS=/path/to/source1:/path/to/source2
CELLPOSE_DATASET_DIR=/path/to/cellpose_dataset
CELLPOSE_INPUT_DATASET_DIR=/path/to/macrophage_initial
CELLPOSE_OUTPUT_DATASET_DIR=/path/to/macrophage_preprocessed
CELLPOSE_RAW_FRAMES_DIR=/path/to/manual_fiji_frames
CELLPOSE_MODEL_PATH=/path/to/trained_cellpose_model
CELLPOSE_PRETRAINED_MODEL=cpsam
